    "smoke": "node scripts/smoke.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "bin": {
    "mctwain": "src/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mormitech/mctwain.git"
  },
  "homepage": "https://github.com/mormitech/mctwain"
