{
  "name": "mctwain",
  "version": "0.3.0",
  "description": "Local scanner helper that lets web pages scan from network scanners (eSCL/AirScan).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
